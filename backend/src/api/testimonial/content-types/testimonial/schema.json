{
    "kind": "collectionType",
    "collectionName": "testimonials",
    "info": {
        "singularName": "testimonial",
        "pluralName": "testimonials",
        "displayName": "Testimonial",
        "description": "Client testimonials with admin approval"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "name": {
            "type": "string",
            "required": true
        },
        "role": {
            "type": "string"
        },
        "location": {
            "type": "string"
        },
        "text": {
            "type": "text",
            "required": true
        },
        "service": {
            "type": "enumeration",
            "enum": [
                "Administratif",
                "Immobilier",
                "Business",
                "Culture",
                "Construction",
                "Investissement"
            ],
            "required": true
        },
        "rating": {
            "type": "integer",
            "min": 1,
            "max": 5,
            "default": 5
        },
        "photo": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "images"
            ]
        },
        "approved": {
            "type": "boolean",
            "default": false,
            "required": true
        }
    }
}