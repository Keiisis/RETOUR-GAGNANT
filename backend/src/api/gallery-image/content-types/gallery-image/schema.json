{
    "kind": "collectionType",
    "collectionName": "gallery_images",
    "info": {
        "singularName": "gallery-image",
        "pluralName": "gallery-images",
        "displayName": "Galerie Photo",
        "description": "Photos de la galerie immersive"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "title": {
            "type": "string"
        },
        "category": {
            "type": "enumeration",
            "enum": [
                "Tradition",
                "Patrimoine",
                "Paysage",
                "Gastronomie",
                "Architecture",
                "Culture",
                "Vie Quotidienne",
                "Monument",
                "Art",
                "Autre"
            ]
        },
        "photo": {
            "type": "media",
            "allowedTypes": [
                "images"
            ],
            "multiple": false,
            "required": true
        },
        "order": {
            "type": "integer",
            "default": 0
        },
        "featured": {
            "type": "boolean",
            "default": false
        }
    }
}