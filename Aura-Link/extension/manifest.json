{
    "manifest_version": 3,
    "name": "Aura Hive — AI Meta-Agent Bridge",
    "version": "4.0.0",
    "description": "Meta-Agent bridge: inject files, control AI drones, run autonomous Hive loops across Claude, ChatGPT, Gemini, Arena & Copilot.",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "http://localhost:3666/*",
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://arena.lmsys.org/*",
        "https://chat.lmsys.org/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://claude.ai/*",
                "https://chatgpt.com/*",
                "https://chat.openai.com/*",
                "https://arena.lmsys.org/*",
                "https://chat.lmsys.org/*",
                "https://gemini.google.com/*",
                "https://copilot.microsoft.com/*",
                "https://*.arena.ai/*",
                "https://arena.ai/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "styles.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Aura Link — Ultimate AI Bridge"
    }
}