# Mobile env vars — copy this file to `.env.local` for local development.
#
# WHY .env.local AND NOT .env?
#  - `.env.local` is gitignored (won't be committed)
#  - `expo start` reads it automatically with priority over `.env`
#  - For BUILDS (eas build), variables come from `eas.json` `build.<profile>.env`,
#    NOT from this file. EAS Build does not embed local .env files.
#
# WHEN TO USE EACH:
#  - Local dev with Next dev server on your PC : set EXPO_PUBLIC_API_URL=http://<your-LAN-IP>:3000
#  - Local dev hitting prod : set EXPO_PUBLIC_API_URL=https://www.retourgagnantbenin.bj
#  - EAS preview/production builds : already configured in eas.json (always prod URL)

EXPO_PUBLIC_SUPABASE_URL=https://ywvsfhqdtkgzavxsumnk.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<paste anon key from Supabase dashboard>

# Set to your LAN IP (e.g. http://192.168.1.42:3000) to test against a local Next dev server.
# Otherwise, use the prod URL.
EXPO_PUBLIC_API_URL=https://www.retourgagnantbenin.bj
